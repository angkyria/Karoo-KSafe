<?xml version="1.0" encoding="utf-8"?>
<!--
  Generic field view with auto-sizing text — COLOURED MODE.
  Background colour and hint visibility are set programmatically via RemoteViews.
  Text colour is hard-coded white because this layout is paired with a
  rider-picked dark background (≥4.5:1 contrast). For Karoo-theme passthrough (no
  custom background, theme-driven text colour), the DataType inflates field_view_auto.xml
  instead — selected at runtime per emission via the FIELD_COLOR_AUTO sentinel.

  Text gravity is set HERE (center) and must never be set through RemoteViews:
  TextView.setGravity() only became a @RemotableViewMethod in Android 12 (API 31). On
  older hosts such as the Karoo 2 (Android 8.1) a setInt(R.id.field_text_*, "setGravity", …)
  action throws ActionException while the ride app applies the RemoteViews, so the
  whole field — text, colour and tap PendingIntent — fails to render and taps never
  reach KSafe (host log: "Extensions: Error in view for TYPE_EXT::ksafe::…").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Main label — bold, up to 2 lines, auto-scales from 6sp to 22sp -->
    <TextView
        android:id="@+id/field_text_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="6sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Hint line — smaller, 1 line, auto-scales from 7sp to 13sp.
         Bumped up from 5-11sp so short legends like "25g", "ml", "carb/h"
         remain readable on a Karoo screen at a glance; still clearly
         secondary to the main label / value above. -->
    <TextView
        android:id="@+id/field_text_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#CCFFFFFF" />

</LinearLayout>
